# Copy this file to .env and fill in your values.
# The backup script reads credentials only from environment variables.

# -------------------------
# GitHub account to back up
# -------------------------
# For a personal account, use your GitHub username.
# For an organization, use the org name and set GITHUB_ACCOUNT_TYPE=org.
GITHUB_ACCOUNT=your-github-username-or-org
GITHUB_ACCOUNT_TYPE=user

# Use classic for full personal backups including gists.
# Use fine only if you know your token covers every endpoint you need.
GITHUB_TOKEN_TYPE=classic
GITHUB_TOKEN=ghp_replace_me

# Optional: use SSH for git clone/fetch operations.
# The token is still required for API metadata, issues, PRs, releases, gists, etc.
GITHUB_BACKUP_PREFER_SSH=false

# Optional: clone all starred repositories, not only store starred repo metadata.
# This may download a lot of third-party data. github-backup does not expose
# a per-starred-repo filter, so this is handled as one cleanup unit.
GITHUB_BACKUP_INCLUDE_STARRED_REPOSITORY_CLONES=false

# Optional: append custom github-backup arguments, for example:
# GITHUB_BACKUP_EXTRA_ARGS="--throttle-limit 100 --throttle-pause 60"
GITHUB_BACKUP_EXTRA_ARGS=
GITHUB_BACKUP_LOG_LEVEL=info

# Number of repositories to discover with gh repo list.
# Increase if the account/org owns more than 1000 repos.
GITHUB_REPO_LIST_LIMIT=1000

# -------------------------
# Item-by-item staging
# -------------------------
# The script backs up one item, uploads that item to R2 through Restic, then
# deletes the local staging directory after the upload succeeds.
BACKUP_STAGING_ROOT=$HOME/github-r2-backup-stage
BACKUP_CLEANUP_AFTER_UPLOAD=true
BACKUP_DELETE_STALE_STAGE_BEFORE_ITEM=true

# Toggle backup groups.
BACKUP_INCLUDE_ACCOUNT_METADATA=true
BACKUP_INCLUDE_REPOSITORIES=true
BACKUP_INCLUDE_GISTS=true

# -------------------------
# Cloudflare R2 / Restic
# -------------------------
# R2 S3 endpoint format:
# s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET_NAME>/<OPTIONAL_PREFIX>
RESTIC_REPOSITORY=s3:https://replace_with_account_id.r2.cloudflarestorage.com/replace_with_bucket_name/github-restic

# R2 access key credentials.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=auto

# Restic encryption password. Store this safely outside this repo as well.
# Alternative: leave RESTIC_PASSWORD empty and set RESTIC_PASSWORD_FILE or RESTIC_PASSWORD_COMMAND.
RESTIC_PASSWORD=replace_with_a_long_random_password
# RESTIC_PASSWORD_FILE=/home/your-user/.config/github-r2-backup/restic-password
# RESTIC_PASSWORD_COMMAND=pass show backups/github-r2-restic

# Retention policy applied after all item snapshots finish successfully.
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
RESTIC_RUN_FORGET=true

# Repository verification after the backup run.
RESTIC_RUN_CHECK=true
RESTIC_CHECK_READ_DATA_SUBSET=1G
